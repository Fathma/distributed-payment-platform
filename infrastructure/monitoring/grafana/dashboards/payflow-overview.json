{
  "id": null,
  "uid": "payflow-overview",
  "title": "PayFlow Overview",
  "tags": ["payflow", "payments"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Service Scrape Status", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "up{job=\"payflow-services\"}", "legendFormat": "{{instance}}", "refId": "A" }], "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" } },
    { "id": 2, "type": "timeseries", "title": "HTTP Request Rate", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "sum by (service) (rate(payflow_http_requests_total[5m]))", "legendFormat": "{{service}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 3, "type": "timeseries", "title": "HTTP p95 Latency", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (service, le) (rate(payflow_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 4, "type": "timeseries", "title": "HTTP 5xx Rate", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "sum by (service) (rate(payflow_http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 5, "type": "timeseries", "title": "Payment Outcomes", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "sum by (outcome) (rate(payflow_payment_outcomes_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 6, "type": "timeseries", "title": "Retries and DLQ", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "sum by (failure_code) (rate(payflow_payment_retries_total[5m]))", "legendFormat": "retry {{failure_code}}", "refId": "A" }, { "expr": "sum by (action) (rate(payflow_dlq_messages_total[5m]))", "legendFormat": "DLQ {{action}}", "refId": "B" }], "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 7, "type": "timeseries", "title": "Kafka Consumer Lag", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "sum by (group, topic) (payflow_kafka_consumer_lag)", "legendFormat": "{{group}} / {{topic}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 8, "type": "timeseries", "title": "Dependency Probe p95", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 }, "datasource": { "type": "prometheus", "uid": "payflow-prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (service, dependency, le) (rate(payflow_dependency_check_duration_seconds_bucket[5m])))", "legendFormat": "{{service}} / {{dependency}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }, "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } }
  ]
}
