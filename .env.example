NODE_ENV=development
JWT_SECRET=local-only-change-this-jwt-secret-before-deploying
DEV_CUSTOMER_EMAIL=customer@example.test
DEV_CUSTOMER_PASSWORD=customer-dev-password
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=admin-dev-password
ORDER_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
PAYMENT_WORKER_PORT=3003
API_GATEWAY_PORT=3000
ORDER_DATABASE_URL=postgresql://order_app:order_dev_password@localhost:5432/order_db
PAYMENT_DATABASE_URL=postgresql://payment_app:payment_dev_password@localhost:5432/payment_db
WORKER_DATABASE_URL=postgresql://worker_app:worker_dev_password@localhost:5432/worker_db
DLQ_ADMIN_TOKEN=replace-this-local-admin-token
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
MOCK_PROVIDER_MODE=success
MOCK_PROVIDER_SUCCESS_RATE=0.9
MOCK_PROVIDER_TIMEOUT_MS=1500
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
